RPC_URL=https://testnet-rpc.monad.xyz
# Required: production/testnet security multisig. For initial testing this can
# be the deployer address, then transfer the role to a multisig in two steps.
SECURITY_ADMIN=0xYOUR_MULTISIG_OR_ADMIN_ADDRESS
# Optional: use PRIVATE_KEY or the encrypted Foundry account described in README.
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY
